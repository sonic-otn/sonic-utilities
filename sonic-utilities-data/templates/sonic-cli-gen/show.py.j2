def format_attr_value(entry, attr):
    """ Helper that formats attribute to be presented in the table output.

    Args:
        entry (Dict[str, str]): CONFIG DB entry configuration.
        attr (Dict): Attribute metadata.

    Returns:
        str: formatted attribute value.
    """

    #TODO: Add support for leaf-list attributes
    # There is a bug for show leaf-list.
    #if attr["is-leaf-list"]:
    #    return "\n".join(entry.get(attr["name"], []))
    return entry.get(attr["name"], "N/A")


def format_group_value(entry, attrs):
    """ Helper that formats grouped attribute to be presented in the table output.

    Args:
        entry (Dict[str, str]): CONFIG DB entry configuration.
        attrs (List[Dict]): Attributes metadata that belongs to the same group.

    Returns:
        str: formatted group attributes.
    """

    data = []
    for attr in attrs:
        if entry.get(attr["name"]):
            data.append((attr["name"] + ":", format_attr_value(entry, attr)))
    return tabulate.tabulate(data, tablefmt="plain")


def get_db_table(db, db_name, table_name):
    """ Retrieve data table from redis DB, support CONFIG_DB|STATE_DB|...

    Args:
        db: Db object in utilities_common.
        db_name: Redis db name
        table_name: Redis table name

    Returns:
        dict: data table.
    """

    table = {}

    if db_name == '' or db_name == 'CONFIG_DB':
        table = db.cfgdb.get_table(table_name)
    else:
        db.db.connect(db_name)
        seps = db.db.get_db_separator(db_name)
        keys = db.db.keys(db_name, table_name + seps + '*')

        for key in keys:
            t = db.db.get_all(db_name, key)
            table[key[(key.find(seps) + 1):]] = t

    return table


def format_object_label(key):
    """ Helper that formats a table key for vertical output header.

    Args:
        key (Union[str, Tuple[str, ...]]): Table key.

    Returns:
        str: formatted object label.
    """

    if isinstance(key, tuple):
        return " | ".join(str(k) for k in key)

    return str(key)


def format_vertical_label(name):
    """ Helper that formats a field name for vertical output.

    Args:
        name (str): Field or key header name.

    Returns:
        str: formatted field label. Sentence-style capitalization in titles and headings.
    """

    name = str(name)
    if not name:
        return name

    return name.lower().capitalize()


def wrap_vertical_value(value):
    """ Helper that wraps a value for vertical output.

    Args:
        value (Any): Value to be displayed.

    Returns:
        List[str]: wrapped value lines.
    """

    wrapped_lines = []

    for line in str(value).splitlines() or [""]:
        parts = textwrap.wrap(
            line,
            width=VALUE_COLUMN_MAX_WIDTH,
            replace_whitespace=False,
            drop_whitespace=False
        )
        wrapped_lines.extend(parts or [""])

    return wrapped_lines or [""]


def render_vertical_blocks(key_header, object_headers, field_names, field_units, object_rows):
    """ Helper that renders table data as vertical output blocks.

    Args:
        key_header (str): Header label for object key line.
        object_headers (List[str]): Object key labels.
        field_names (List[str]): Field names to display.
        field_units (List[str]): Units for each field, parallel to field_names.
        object_rows (List[List[str]]): Table rows without key columns.
    """

    key_header = format_vertical_label(key_header)
    display_field_names = [format_vertical_label(field_name) for field_name in field_names]
    label_width = max((len(field_name) for field_name in display_field_names), default=0)

    for index, object_header in enumerate(object_headers):
        click.echo("{} {}".format(key_header, object_header))

        object_row = object_rows[index] if index < len(object_rows) else []

        for field_index, field_name in enumerate(display_field_names):
            value = object_row[field_index] if field_index < len(object_row) else "N/A"
            unit = field_units[field_index] if field_index < len(field_units) else ""
            if unit and value not in ("", "N/A"):
                value = "{}{}".format(value, unit)
            wrapped_lines = wrap_vertical_value(value)

            click.echo("    {label:<{width}} :  {value}".format(
                label=field_name,
                width=label_width,
                value=wrapped_lines[0]
            ))

            for wrapped_line in wrapped_lines[1:]:
                click.echo("    {label:<{width}}    {value}".format(
                    label="",
                    width=label_width,
                    value=wrapped_line
                ))

        if index != len(object_headers) - 1:
            click.echo()

